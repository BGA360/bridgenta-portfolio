---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LearningLevelBadge from '../components/LearningLevelBadge.astro';
import LearningStatusNotice from '../components/LearningStatusNotice.astro';

export interface Props {
  mode: 'published' | 'preview';
  entry: CollectionEntry<'learning'>;
  categoryEntry: CollectionEntry<'learningCategories'>;
  Content: any;
}

const { mode, entry, categoryEntry, Content } = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://bridgenta.de';

const isPreview = mode === 'preview';

const learningBreadcrumbs = isPreview
  ? [
      { name: 'Startseite', url: `${siteUrl}/` },
      { name: 'Lernen', url: `${siteUrl}/lernen/` },
      { name: categoryEntry.data.name, url: `${siteUrl}/lernen/themen/${categoryEntry.id}/` },
      { name: `[Vorschau] ${entry.data.title}`, url: `${siteUrl}/lernen/preview/${entry.slug}/` },
    ]
  : [
      { name: 'Startseite', url: `${siteUrl}/` },
      { name: 'Lernen', url: `${siteUrl}/lernen/` },
      { name: categoryEntry.data.name, url: `${siteUrl}/lernen/themen/${categoryEntry.id}/` },
      { name: entry.data.title, url: `${siteUrl}/lernen/${entry.slug}/` },
    ];

const learningArticle = isPreview || !entry.data.publishedAt
  ? undefined
  : {
      title: entry.data.title,
      description: entry.data.description,
      categoryName: categoryEntry.data.name,
      publishedAt: entry.data.publishedAt.toISOString(),
      ...(entry.data.updatedAt ? { updatedAt: entry.data.updatedAt.toISOString() } : {}),
    };

const formattedPublishDate = entry.data.publishedAt
  ? entry.data.publishedAt.toLocaleDateString('de-DE', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;

const formattedUpdateDate = entry.data.updatedAt
  ? entry.data.updatedAt.toLocaleDateString('de-DE', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
---

<Layout
  title={isPreview ? `[Vorschau] ${entry.data.seoTitle || entry.data.title}` : (entry.data.seoTitle || entry.data.title)}
  description={entry.data.seoDescription || entry.data.description}
  robots={isPreview ? "noindex, nofollow" : "index, follow"}
  pageKind="learning-article"
  learningBreadcrumbs={learningBreadcrumbs}
  learningArticle={learningArticle}
>
  <main class="container learning-article">
    <Breadcrumbs breadcrumbs={learningBreadcrumbs} />
    
    <article class="learning-prose">
      <header class="learning-article__header">
        {isPreview && (
          <div class="learning-draft-preview-banner" style="background-color: #fef3c7; color: #92400e; padding: 0.75rem 1rem; border-radius: 0.375rem; margin-bottom: 1.5rem; font-weight: 600;">
            <span>⚠️ LOKALE ENTWURFS-VORSCHAU — NICHT VERÖFFENTLICHT</span>
          </div>
        )}

        <div class="learning-article__meta-top">
          <a href={`/lernen/themen/${categoryEntry.id}/`} class="learning-article__category-link">
            {categoryEntry.data.name}
          </a>
          <LearningLevelBadge level={entry.data.learningLevel} />
        </div>
        
        <h1>{entry.data.title}</h1>
        
        <p class="lede">
          {entry.data.description}
        </p>

        {!isPreview && formattedPublishDate && (
          <div class="learning-article__meta-dates">
            <span>Veröffentlicht am {formattedPublishDate}</span>
            {formattedUpdateDate && <span>&bull; Aktualisiert am {formattedUpdateDate}</span>}
          </div>
        )}

        {!isPreview && entry.data.publicStatus && (
          <LearningStatusNotice status={entry.data.publicStatus} />
        )}
      </header>

      <section class="tina-content">
        <Content />
      </section>

      <footer class="learning-article__footer">
        <div class="learning-article__project-context">
          <p>
            <em>Diese Lernserie kommt aus echten, laufenden Projekten. Wir zeigen unsere Annahmen, Fehler, Fragen, Prüfungen und Entscheidungen. Spätere Belege können diese Erkenntnisse bestätigen, verbessern oder korrigieren.</em>
          </p>
        </div>

        <div class="learning-article__signature">
          <p class="learning-signature__text">Aus echten Projekten lernen.</p>
          <p class="learning-signature__subtext">Nicht nur das Ergebnis. Auch der Weg dorthin.</p>
        </div>

        <div class="learning-footer-nav">
          <a href={`/lernen/themen/${categoryEntry.id}/`} class="btn btn--secondary">
            &larr; Zurück zu {categoryEntry.data.name}
          </a>
          <a href="/lernen/" class="btn btn--text">
            Zurück zur Lernübersicht
          </a>
        </div>
      </footer>
    </article>
  </main>
  <script>
    document.querySelectorAll('.tina-content blockquote').forEach((bq) => {
      if (bq.innerHTML.includes('[!IMPORTANT]')) {
        bq.innerHTML = bq.innerHTML.replace('[!IMPORTANT]', '<strong class="learning-important-label" style="display: block; margin-bottom: 0.5rem; color: var(--magenta-deep);">Wichtiger Hinweis:</strong>');
      }
    });
  </script>
</Layout>

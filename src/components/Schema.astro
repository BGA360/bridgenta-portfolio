---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  project?: {
    title: string;
    category: string;
    status: string;
    technologies: string;
    description: string;
    schemaType?: string;
  };
  pageKind?: 'default' | 'learning-root' | 'learning-category' | 'learning-article';
  learningBreadcrumbs?: BreadcrumbItem[];
  learningArticle?: {
    title: string;
    description: string;
    categoryName: string;
    publishedAt: string;
    updatedAt?: string;
  };
}

const {
  title,
  description,
  project,
  canonical,
  pageKind = 'default',
  learningBreadcrumbs,
  learningArticle
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://bridgenta.de';
const pathname = Astro.url.pathname;

// Define base Person entity
const personId = `${siteUrl}/#person`;
const personSchema = {
  '@type': 'Person',
  '@id': personId,
  'name': 'Frank Duru',
  'jobTitle': 'Webmaster mit Fokus auf KI-gestützte Softwareentwicklung',
  'email': 'ref@bridgenta.de',
  'url': siteUrl,
  'image': `${siteUrl}/images/FDPP-001.webp`, // Approved portrait identifier
  'description': 'Webmaster seit 2009 mit Fokus auf IT-Sicherheit, Systemadministration und KI-gestützte Softwareentwicklung.',
  'sameAs': [
    'https://www.linkedin.com/in/frank-duru/',
    'https://x.com/frankdurux'
  ]
};

// Define base Organization entity (BridGenta)
const orgId = `${siteUrl}/#organization`;
const organizationSchema = {
  '@type': 'Organization',
  '@id': orgId,
  'name': 'BridGenta',
  'url': siteUrl,
  'logo': `${siteUrl}/favicon.svg`,
  'founder': { '@id': personId },
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Frankfurt am Main',
    'addressRegion': 'Hessen',
    'addressCountry': 'DE'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': '50.1109',
    'longitude': '8.6821'
  },
  'serviceArea': [
    { '@type': 'AdministrativeArea', 'name': 'Frankfurt am Main' },
    { '@type': 'AdministrativeArea', 'name': 'Hessen' },
    { '@type': 'AdministrativeArea', 'name': 'Deutschland' },
    { '@type': 'AdministrativeArea', 'name': 'Remote' }
  ]
};

// Define Website Entity
const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  'url': siteUrl,
  'name': 'BridGenta.de',
  'publisher': { '@id': orgId },
  'description': 'Portfolio von Frank Duru – Web Development, AI-assisted Development und SEO/AEO/GEO.'
};

// Define breadcrumbs schema
let breadcrumbItems;
if (learningBreadcrumbs) {
  breadcrumbItems = learningBreadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'item': {
      '@id': item.url,
      'name': item.name
    }
  }));
} else {
  // Define dynamic Breadcrumbs
  const pathSegments = pathname.split('/').filter(Boolean);
  breadcrumbItems = [
    {
      '@type': 'ListItem',
      'position': 1,
      'item': {
        '@id': siteUrl,
        'name': 'Startseite'
      }
    }
  ];

  let accumulatedPath = '';
  pathSegments.forEach((segment, index) => {
    accumulatedPath += `/${segment}`;
    
    // Format the name nicely based on the path
    let name = segment;
    if (segment === 'projects') name = 'Projekte';
    else if (segment === 'about') name = 'Über mich';
    else if (segment === 'contact') name = 'Kontakt';
    else if (segment === 'impressum') name = 'Impressum';
    else if (segment === 'datenschutz') name = 'Datenschutz';
    else if (project && segment.startsWith('project-')) name = project.title;
    else {
      // Capitalize first letter as fallback
      name = segment.charAt(0).toUpperCase() + segment.slice(1);
    }

    breadcrumbItems.push({
      '@type': 'ListItem',
      'position': index + 2,
      'item': {
        '@id': `${siteUrl}${accumulatedPath}`,
        'name': name
      }
    });
  });
}

const breadcrumbListSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  'itemListElement': breadcrumbItems
};

// Define voice search / speakable specification
const speakableSchema = {
  '@type': 'SpeakableSpecification',
  'cssSelector': ['h1', '.lede', '.tina-content p']
};

// Compile base graph
const graph = [
  personSchema,
  organizationSchema,
  websiteSchema,
  breadcrumbListSchema
];

// If on a project page, inject dynamic schema type
if (project) {
  const schemaType = project.schemaType || 'CreativeWork';
  const projectSchema: any = {
    '@type': schemaType,
    '@id': `${canonical}#project`,
    'name': project.title,
    'description': project.description || description,
    'url': canonical,
    'creator': { '@id': personId },
    'publisher': { '@id': orgId }
  };

  if (schemaType === 'SoftwareApplication' || schemaType === 'WebApplication') {
    projectSchema['applicationCategory'] = project.category;
    projectSchema['softwareRequirements'] = project.technologies;
    projectSchema['developmentStatus'] = project.status === 'In Entwicklung'
      ? 'https://schema.org/ActiveActionStatus'
      : 'https://schema.org/PotentialActionStatus';
  } else {
    // Standard CreativeWork fields
    projectSchema['genre'] = project.category;
  }

  graph.push(projectSchema);
}

// Define the primary WebPage entity to link the graph nodes together
const webpageType = (pageKind === 'learning-root' || pageKind === 'learning-category') ? 'CollectionPage' : 'WebPage';
const webpageEntity: any = {
  '@type': webpageType,
  '@id': `${canonical}#webpage`,
  'url': canonical,
  'name': title,
  'description': description,
  'isPartOf': { '@id': `${siteUrl}/#website` },
  'breadcrumb': { '@id': `${canonical}#breadcrumb` },
  'publisher': { '@id': orgId },
  'author': { '@id': personId },
  'speakable': speakableSchema
};

if (pageKind === 'learning-root' || pageKind === 'learning-category' || pageKind === 'learning-article') {
  webpageEntity['inLanguage'] = 'de';
}

if (project) {
  webpageEntity['about'] = { '@id': `${canonical}#project` };
}

if (pageKind === 'learning-article' && learningArticle) {
  webpageEntity['mainEntity'] = { '@id': `${canonical}#article` };

  const techArticleSchema: any = {
    '@type': 'TechArticle',
    '@id': `${canonical}#article`,
    'mainEntityOfPage': { '@id': `${canonical}#webpage` },
    'headline': learningArticle.title,
    'description': learningArticle.description,
    'author': { '@id': personId },
    'publisher': { '@id': orgId },
    'articleSection': learningArticle.categoryName,
    'datePublished': learningArticle.publishedAt,
    'inLanguage': 'de'
  };

  if (learningArticle.updatedAt) {
    techArticleSchema['dateModified'] = learningArticle.updatedAt;
  }

  graph.push(techArticleSchema);
}

graph.push(webpageEntity);

// Wrap in standard JSON-LD Schema wrapper
const webpageSchema = {
  '@context': 'https://schema.org',
  '@graph': graph
};
---

<script type="application/ld+json" set:html={JSON.stringify(webpageSchema)}></script>

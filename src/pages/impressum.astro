---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impressum und Anbieterkennzeichnung" description="Gesetzliche Anbieterinformationen und Kontaktangaben für die Website BridGenta.de.">
  <section class="page-hero">
    <div class="page-hero__inner">
      <span class="eyebrow">Rechtliches</span>
      <h1 style="margin-top:0.9rem;">Impressum</h1>
      <p class="lede">Gesetzliche Angaben gemäß § 5 DDG.</p>
    </div>
  </section>

  <div class="floating-card-overlap">
    <div class="breadcrumb-card">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Startseite</a><span class="sep">/</span><span>Impressum</span>
      </nav>
    </div>
  </div>

  <section class="section" data-reveal>
    <div class="container" style="max-width: 800px;">
      <div class="card" style="padding: var(--space-4);">
        <h2>Angaben gemäß § 5 DDG</h2>
        <p style="margin-top: 1rem; color: var(--text-dark); font-size: 1.05rem; line-height: 1.6;">
          Frank Duru<br>
          BridGenta.de<br>
          [OWNER_REQUIRED: LADUNGSFÄHIGE STRASSENANSCHRIFT]<br>
          [OWNER_REQUIRED: PLZ] Leverkusen<br>
          Deutschland
        </p>

        <h3 style="margin-top: 2rem; font-size: 1.25rem;">Kontakt</h3>
        <p style="margin-top: 0.5rem; color: var(--text-dark); font-size: 1.05rem; line-height: 1.6;">
          E-Mail: <a href="mailto:ref@bridgenta.de" style="color: var(--magenta); text-decoration: none;">ref@bridgenta.de</a><br>
          Website: https://bridgenta.de
        </p>
      </div>
    </div>
  </section>
</Layout>

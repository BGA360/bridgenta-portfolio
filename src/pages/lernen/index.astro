---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

import { observeArticleEligibility, observeCategoryEligibility } from '../../utils/m5_adapter';

// Fetch categories dynamically
const categories = await getCollection('learningCategories');

// Fetch learning articles dynamically, filter to only published
const articles = await getCollection('learning');
const observedArticles = observeArticleEligibility(articles);
const publishedArticles = observedArticles.filter(
  (art) => art.data.publicationState === 'published'
);

const observedCategories = observeCategoryEligibility(categories, publishedArticles);

// Group articles by category
const articlesByCategory = new Map();
for (const cat of categories) {
  articlesByCategory.set(cat.id, []);
}

for (const art of publishedArticles) {
  const catId = art.data.category.id;
  if (articlesByCategory.has(catId)) {
    articlesByCategory.get(catId).push(art);
  }
}

const hasPublishedArticles = publishedArticles.length > 0;
const robots = hasPublishedArticles ? "index, follow" : "noindex, follow";

const siteUrl = Astro.site ? Astro.site.origin : 'https://bridgenta.de';
const learningBreadcrumbs = [
  { name: 'Startseite', url: `${siteUrl}/` },
  { name: 'Lernen', url: `${siteUrl}/lernen/` }
];
---

<Layout title="Lernen" description="Wissensdatenbank." robots={robots} pageKind="learning-root" learningBreadcrumbs={learningBreadcrumbs}>
  <main class="container learning-root">
    <Breadcrumbs breadcrumbs={learningBreadcrumbs} />
    
    <header class="learning-root__header">
      <span class="eyebrow">Wissen</span>
      <h1>Lernen</h1>
      <p class="lede">
        Willkommen in unserer Wissensdatenbank. Hier teilen wir praxisnahe Erkenntnisse aus der Softwareentwicklung.
      </p>
    </header>

    <section class="learning-grid">
      {observedCategories.map((cat) => {
        const catArticles = articlesByCategory.get(cat.id) || [];
        const count = catArticles.length;
        return (
          <div class="learning-category-card">
            <div class="learning-category-card__content">
              <h2 class="learning-category-card__title">
                <a href={`/lernen/themen/${cat.id}/`}>
                  {cat.data.name}
                </a>
              </h2>
              <p class="learning-category-card__description">{cat.data.description}</p>
            </div>
            
            <div class="learning-category-card__footer">
              <span class="learning-category-card__count">
                {count} {count === 1 ? 'Artikel' : 'Artikel'}
              </span>
              
              {count === 0 && (
                <p class="learning-category-card__empty">
                  Noch keine veröffentlichten Lernartikel in diesem Thema.
                </p>
              )}
            </div>
          </div>
        );
      })}
    </section>
  </main>
</Layout>

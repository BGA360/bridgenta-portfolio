---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('learning');
  const publishedArticles = articles.filter(
    (art) => art.data.publicationState === 'published'
  );

  for (const article of publishedArticles) {
    if (article.slug.includes('/')) {
      throw new Error(
        `[ROUTE BUILD FAIL] Nested article found: "${article.id}". Learning articles must be flat under src/content/learning/.`
      );
    }
    if (article.slug === 'themen') {
      throw new Error(
        `[ROUTE BUILD FAIL] Article slug matches reserved word "themen": "${article.id}".`
      );
    }
  }

  return publishedArticles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Fetch the associated category data
const categoryEntry = await getEntry('learningCategories', entry.data.category.id);
---

<Layout title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDescription || entry.data.description}>
  <div class="container" style="padding: 4rem 1rem; max-width: 800px;">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb" style="margin-bottom: 2rem; font-size: 0.9rem; color: #666;">
      <a href="/" style="color: inherit; text-decoration: none;">Startseite</a><span style="margin: 0 0.5rem;">/</span>
      <a href="/lernen/" style="color: inherit; text-decoration: none;">Lernen</a><span style="margin: 0 0.5rem;">/</span>
      <a href={`/lernen/themen/${categoryEntry.id}/`} style="color: inherit; text-decoration: none;">{categoryEntry.data.name}</a><span style="margin: 0 0.5rem;">/</span>
      <span style="color: #333; font-weight: 500;">{entry.data.title}</span>
    </nav>

    <article class="learning-article">
      <header style="margin-bottom: 3rem; border-bottom: 1px solid #eee; padding-bottom: 1.5rem;">
        <h1 style="font-size: 2.5rem; margin-bottom: 1rem; color: #C2185B; line-height: 1.2;">{entry.data.title}</h1>
        <div class="metadata" style="display: flex; gap: 1.5rem; font-size: 0.9rem; color: #666; margin-bottom: 1rem;">
          <span><strong>Thema:</strong> {categoryEntry.data.name}</span>
          <span><strong>Level:</strong> {entry.data.learningLevel}</span>
        </div>
        <p style="font-size: 1.15rem; color: #555; font-style: italic; line-height: 1.6; margin: 0;">
          {entry.data.description}
        </p>
      </header>

      <div class="tina-content" style="line-height: 1.8; font-size: 1.1rem; color: #222;">
        <Content />
      </div>
    </article>
  </div>
</Layout>

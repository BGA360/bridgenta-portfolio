---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LearningLevelBadge from '../../components/LearningLevelBadge.astro';
import LearningStatusNotice from '../../components/LearningStatusNotice.astro';
import { observeArticleEligibility } from '../../utils/m5_adapter';

export async function getStaticPaths() {
  const articles = await getCollection('learning');
  const observedArticles = observeArticleEligibility(articles);
  const publishedArticles = observedArticles.filter(
    (art) => art.data.publicationState === 'published'
  );

  for (const article of publishedArticles) {
    if (article.slug.includes('/')) {
      throw new Error(
        `[ROUTE BUILD FAIL] Nested article found: "${article.id}". Learning articles must be flat under src/content/learning/.`
      );
    }
    if (article.slug === 'themen') {
      throw new Error(
        `[ROUTE BUILD FAIL] Article slug matches reserved word "themen": "${article.id}".`
      );
    }
  }

  return publishedArticles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Fetch the associated category data
const categoryEntry = await getEntry('learningCategories', entry.data.category.id);

const siteUrl = Astro.site ? Astro.site.origin : 'https://bridgenta.de';
const learningBreadcrumbs = [
  { name: 'Startseite', url: `${siteUrl}/` },
  { name: 'Lernen', url: `${siteUrl}/lernen/` },
  { name: categoryEntry.data.name, url: `${siteUrl}/lernen/themen/${categoryEntry.id}/` },
  { name: entry.data.title, url: `${siteUrl}/lernen/${entry.slug}/` }
];

const learningArticle = {
  title: entry.data.title,
  description: entry.data.description,
  categoryName: categoryEntry.data.name,
  publishedAt: entry.data.publishedAt.toISOString()
};

if (entry.data.updatedAt) {
  learningArticle.updatedAt = entry.data.updatedAt.toISOString();
}

const formattedPublishDate = entry.data.publishedAt.toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdateDate = entry.data.updatedAt
  ? entry.data.updatedAt.toLocaleDateString('de-DE', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
---

<Layout title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDescription || entry.data.description} pageKind="learning-article" learningBreadcrumbs={learningBreadcrumbs} learningArticle={learningArticle}>
  <main class="container learning-article">
    <Breadcrumbs breadcrumbs={learningBreadcrumbs} />
    
    <article class="learning-prose">
      <header class="learning-article__header">
        <div class="learning-article__meta-top">
          <a href={`/lernen/themen/${categoryEntry.id}/`} class="learning-article__category-link">
            {categoryEntry.data.name}
          </a>
          <LearningLevelBadge level={entry.data.learningLevel} />
        </div>
        
        <h1>{entry.data.title}</h1>
        
        <p class="lede">
          {entry.data.description}
        </p>

        <div class="learning-article__meta-dates">
          <span>Veröffentlicht am {formattedPublishDate}</span>
          {formattedUpdateDate && <span>&bull; Aktualisiert am {formattedUpdateDate}</span>}
        </div>

        {entry.data.publicStatus && (
          <LearningStatusNotice status={entry.data.publicStatus} />
        )}
      </header>

      <hr class="learning-article__divider" />

      <section class="tina-content">
        <Content />
      </section>

      <footer class="learning-article__footer">
        <div class="learning-article__project-context">
          <p>
            <em>Diese Lernserie kommt aus echten, laufenden Projekten. Wir zeigen unsere Annahmen, Fehler, Fragen, Prüfungen und Entscheidungen. Spätere Belege können diese Erkenntnisse bestätigen, verbessern oder korrigieren.</em>
          </p>
        </div>

        <div class="learning-article__signature">
          <p class="learning-signature__text">Aus echten Projekten lernen.</p>
          <p class="learning-signature__subtext">Nicht nur das Ergebnis. Auch der Weg dorthin.</p>
        </div>

        <div class="learning-footer-nav">
          <a href={`/lernen/themen/${categoryEntry.id}/`} class="btn btn--secondary">
            &larr; Zurück zu {categoryEntry.data.name}
          </a>
          <a href="/lernen/" class="btn btn--text">
            Zurück zur Lernübersicht
          </a>
        </div>
      </footer>
    </article>
  </main>
</Layout>

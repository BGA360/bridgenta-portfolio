---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LearningCard from '../../../components/LearningCard.astro';

import { observeArticleEligibility } from '../../../utils/m5_adapter';

export async function getStaticPaths() {
  const categories = await getCollection('learningCategories');
  return categories.map((cat) => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;

// Fetch articles belonging to this category and filter by publicationState === 'published'
const allArticles = await getCollection('learning');
const observedArticles = observeArticleEligibility(allArticles);
const publishedArticles = observedArticles.filter(
  (art) =>
    art.data.publicationState === 'published' &&
    art.data.category.id === category.id
);

const hasArticles = publishedArticles.length > 0;
const robots = hasArticles ? "index, follow" : "noindex, follow";

const siteUrl = Astro.site ? Astro.site.origin : 'https://bridgenta.de';
const learningBreadcrumbs = [
  { name: 'Startseite', url: `${siteUrl}/` },
  { name: 'Lernen', url: `${siteUrl}/lernen/` },
  { name: category.data.name, url: `${siteUrl}/lernen/themen/${category.id}/` }
];
---

<Layout title={`${category.data.name}`} description={category.data.description} robots={robots} pageKind="learning-category" learningBreadcrumbs={learningBreadcrumbs}>
  <main class="container learning-category">
    <Breadcrumbs breadcrumbs={learningBreadcrumbs} />
    
    <header class="learning-category__header">
      <span class="eyebrow">Thema</span>
      <h1>{category.data.name}</h1>
      <p class="lede">
        {category.data.description}
      </p>
    </header>

    <section class="learning-category__articles">
      <h2>Artikel in dieser Kategorie</h2>

      {publishedArticles.length > 0 ? (
        <div class="learning-articles-list">
          {publishedArticles.map((art) => (
            <LearningCard article={art} />
          ))}
        </div>
      ) : (
        <p class="learning-category__empty">
          Noch keine veröffentlichten Lernartikel in diesem Thema.
        </p>
      )}
    </section>

    <div class="learning-back-link">
      <a href="/lernen/" class="btn btn--secondary">
        &larr; Zurück zur Übersicht
      </a>
    </div>
  </main>
</Layout>
